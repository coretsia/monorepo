# ---------------------------------------
# OS / Editor / IDE
# ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
.fleet/
*.iml

.osp/

# ---------------------------------------
# Environment files (keep examples)
# ---------------------------------------
.env
.env.*
!.env.example
!.env.dist
!.env.sample

# ---------------------------------------
# Tooling fixtures: allow committed .env* under canonical test fixtures
# (these are NOT real secrets; used only for deterministic tests)
# ---------------------------------------
!tools/tests/Fixtures/**/.env
!tools/tests/Fixtures/**/.env.*

# ---------------------------------------
# Composer / PHP dependencies
# (ignore vendor everywhere in monorepo)
# ---------------------------------------
**/vendor/

# ---------------------------------------
# PHPUnit / test artifacts
# ---------------------------------------
.phpunit.result.cache
.phpunit.cache/
**/.phpunit.cache/
coverage/
build/coverage/
clover.xml

# ---------------------------------------
# Static analysis / code style tool caches
# ---------------------------------------
.php-cs-fixer.cache
.php-cs-fixer.dist.php.cache
**/.php-cs-fixer.cache

.phpstan.cache/
**/.phpstan.cache/
.phpstan-cache/
**/.phpstan-cache/
phpstan-baseline.neon.cache

.rector.cache/
**/.rector.cache/

.psalm/
**/.psalm/

# Deptrac
.deptrac.cache

# Infection
infection.log
infection.json
infection.json.dist
.infection/
**/.infection/

# ---------------------------------------
# Logs / temp / runtime artifacts
# ---------------------------------------
*.log
*.tmp
*.swp
/tmp/

# ---------------------------------------
# Repository tooling state
# keep only marker .gitignore files
# ---------------------------------------
/var/*
!/var/.gitignore
!/var/backups/
!/var/backups/.gitignore

# ---------------------------------------
# Skeleton application-template runtime dirs
# keep .gitkeep, ignore everything else inside var/
# ---------------------------------------
/packages/applications/skeleton/var/*
/packages/applications/skeleton/var/**/
!/packages/applications/skeleton/var/*/
/packages/applications/skeleton/var/**/*
!/packages/applications/skeleton/var/**/.gitkeep
!/packages/applications/skeleton/var/*/.gitkeep

# ---------------------------------------
# Node / frontend artifacts (if present)
# ---------------------------------------
**/node_modules/
**/public/build/
**/public/hot
**/.vite/
**/.parcel-cache/

# ---------------------------------------
# PHP runtime / misc
# ---------------------------------------
preload.php
.phpactor/
**/.phpactor/

# ---------------------------------------
# Security / secrets
# ---------------------------------------
*.key
*.pem
*.p12
