{
  "name": "coretsia/monorepo",
  "type": "project",
  "description": "Coretsia monorepo developer workspace",
  "keywords": [
    "framework",
    "psr",
    "ddd",
    "domain-driven-design",
    "modular",
    "enterprise",
    "performance",
    "microservices",
    "events",
    "cqrs",
    "observability"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Vladyslav Mudrichenko",
      "email": "vladyslav@coretsia.dev",
      "role": "Creator and Lead Developer"
    }
  ],
  "homepage": "https://coretsia.dev/",
  "support": {
    "issues": "https://github.com/coretsia/monorepo/issues",
    "source": "https://github.com/coretsia/monorepo"
  },
  "bin": [
    "coretsia"
  ],
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-libxml": "*",
    "coretsia/core-contracts": "0.7.x-dev",
    "coretsia/core-dto-attribute": "0.7.x-dev",
    "coretsia/core-foundation": "0.7.x-dev",
    "coretsia/core-kernel": "0.7.x-dev",
    "coretsia/devtools-internal-toolkit": "0.7.x-dev",
    "coretsia/framework": "0.7.x-dev",
    "coretsia/platform-cli": "0.7.x-dev",
    "coretsia/platform-worker": "0.7.x-dev",
    "coretsia/skeleton": "0.7.x-dev",
    "deptrac/deptrac": "^4.6",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "symplify/easy-coding-standard": "^13.0"
  },
  "suggest": {
    "ext-imagick": "Suggested for optional icon/image asset generation scripts such as build:icons."
  },
  "autoload-dev": {
    "psr-4": {
      "Coretsia\\Tools\\Tests\\": "tools/tests/",
      "Coretsia\\Tools\\Support\\": "tools/support/"
    },
    "exclude-from-classmap": [
      "tools/tests/Fixtures/"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/applications/skeleton",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/skeleton": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/core/contracts",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/core-contracts": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/core/dto-attribute",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/core-dto-attribute": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/core/foundation",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/core-foundation": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/core/kernel",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/core-kernel": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/devtools/internal-toolkit",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/devtools-internal-toolkit": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/framework",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/framework": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/platform/cli",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/platform-cli": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    },
    {
      "type": "path",
      "url": "packages/platform/worker",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "coretsia/platform-worker": "0.7.x-dev"
        }
      },
      "coretsia_managed": true
    }
  ],
  "scripts": {
    "test": [
      "@package:phpunit:gate",
      "@php tools/testing/run_packages_phpunit.php --strict"
    ],
    "gates": [
      "@no-skeleton-http-default:gate",
      "@no-skeleton-bundles-default:gate",
      "@no-skeleton-mode-presets-default:gate",
      "@no-skeleton-modules-default:gate",
      "@contracts-only-ports:gate",
      "@reserved-tags:gate",
      "@observability-naming:gate",
      "@observability-span-naming:gate",
      "@observability-metric-catalog:gate",
      "@artifact-header-schema:gate",
      "@cross-cutting-contract:gate",
      "@kernel-public-api:gate",
      "@toolkit:gate",
      "@tools:ia",
      "@repo:text:gate",
      "@no-runtime-tooling-artifacts:gate",
      "@package-compliance:gate",
      "@package-publish-safety:gate",
      "@atomic-write:gate",
      "@doc-version-drift:gate",
      "@license-header:gate"
    ],
    "security": [
      "@composer-audit:gate",
      "@secret-leakage:gate"
    ],
    "arch": [
      "@arch:package-index:check",
      "@arch:deptrac:check",
      "@arch:deptrac:analyze"
    ],
    "quality": [
      "@cs:check",
      "@phpstan"
    ],
    "setup": [
      "@hooks:install",
      "@sync:repos",
      "@release-line:workspace:sync",
      "@release-line:public-constraints:sync",
      "@composer --no-interaction install --prefer-dist",
      "@composer --no-interaction validate --strict"
    ],
    "ci": [
      "@sync:check",
      "@release-line:workspace:check",
      "@release-line:public-constraints:check",
      "@composer --no-interaction install --prefer-dist",
      "@composer --no-interaction validate --strict",
      "@gates",
      "@dto:gate",
      "@arch",
      "@quality",
      "@test",
      "@lock:check"
    ],
    "composer-audit:gate": "@php tools/gates/composer_audit_gate.php",
    "secret-leakage:gate": "@php tools/gates/secret_leakage_gate.php",
    "dto:gate": "@php tools/gates/dto_gate.php",
    "dto-marker-consistency:gate": "@php tools/gates/dto_marker_consistency_gate.php",
    "dto-no-logic:gate": "@php tools/gates/dto_no_logic_gate.php",
    "dto-shape:gate": "@php tools/gates/dto_shape_gate.php",
    "arch:package-index:check": "@php tools/build/package_index.php --check",
    "arch:package-index:generate": "@php tools/build/package_index.php --apply",
    "arch:deptrac:check": "@php tools/build/deptrac_generate.php --check",
    "arch:deptrac:generate": "@php tools/build/deptrac_generate.php --apply",
    "arch:deptrac:analyze": "@php vendor/bin/deptrac analyse --config-file=tools/testing/deptrac.yaml --no-cache",
    "sync:check": "@php tools/build/sync_composer_repositories.php --check",
    "sync:repos": "@php tools/build/sync_composer_repositories.php",
    "release-line:workspace:sync": "@php tools/release/sync_workspace_release_line.php",
    "release-line:workspace:check": "@php tools/release/sync_workspace_release_line.php --check",
    "release-line:public-constraints:sync": "@php tools/release/sync_package_public_constraints.php",
    "release-line:public-constraints:check": "@php tools/release/sync_package_public_constraints.php --check",
    "package-publish-safety:gate": "@php tools/gates/package_publish_safety_gate.php",
    "atomic-write:gate": "@php tools/gates/atomic_write_gate.php",
    "doc-version-drift:gate": "@php tools/gates/doc_version_drift_gate.php",
    "license-header:gate": "@php tools/gates/license_header_gate.php",
    "toolkit:gate": "@php tools/gates/internal_toolkit_no_dup_gate.php",
    "tools:ia": "@php tools/gates/tools_invalid_argument_exception_gate.php",
    "repo:text:gate": "@php tools/gates/repo_text_normalization_gate.php",
    "no-skeleton-http-default:gate": "@php tools/gates/no_skeleton_http_default_gate.php",
    "no-skeleton-bundles-default:gate": "@php tools/gates/no_skeleton_bundles_default_gate.php",
    "no-skeleton-mode-presets-default:gate": "@php tools/gates/no_skeleton_mode_presets_default_gate.php",
    "no-skeleton-modules-default:gate": "@php tools/gates/no_skeleton_modules_default_gate.php",
    "contracts-only-ports:gate": "@php tools/gates/contracts_only_ports_gate.php",
    "reserved-tags:gate": "@php tools/gates/reserved_tags_registry_gate.php",
    "observability-naming:gate": "@php tools/gates/observability_naming_gate.php",
    "observability-span-naming:gate": "@php tools/gates/observability_span_naming_gate.php",
    "observability-metric-catalog:gate": "@php tools/gates/observability_metric_catalog_gate.php",
    "artifact-header-schema:gate": "@php tools/gates/artifact_header_schema_gate.php",
    "cross-cutting-contract:gate": "@php tools/gates/cross_cutting_contract_gate.php",
    "kernel-public-api:gate": "@php tools/gates/kernel_public_api_gate.php",
    "no-runtime-tooling-artifacts:gate": "@php tools/gates/no_runtime_tooling_artifacts_gate.php",
    "package-compliance:gate": "@php tools/gates/package_compliance_gate.php",
    "package:phpunit:gate": "@php tools/gates/package_phpunit_config_gate.php",
    "package-scaffold:sync": "@php tools/build/sync_package_scaffold.php",
    "package-scaffold:check": "@php tools/build/sync_package_scaffold.php --check",
    "package:new": "@php tools/build/new-package.php",
    "build:icons": "@php tools/build/build_icons.php",
    "cs:check": "@php vendor/bin/ecs check --config=tools/cs/ecs.php",
    "cs:fix": "@php vendor/bin/ecs check --config=tools/cs/ecs.php --fix",
    "phpstan": "@php vendor/bin/phpstan analyse --configuration=tools/phpstan/phpstan.neon --memory-limit=1G",
    "hooks:install": "git config core.hooksPath .githooks",
    "lock:check": "git diff --exit-code -- composer.lock"
  },
  "config": {
    "optimize-autoloader": true,
    "process-timeout": 600,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  }
}
