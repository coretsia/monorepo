# Environment template
#
# Copy this file to .env and uncomment only the overrides you need.
# No environment variables are required by every Coretsia application.
# Keep .env out of version control; never commit real secrets here.
#
# Bootstrap Phase A and ConfigKernel Phase B use separate environment contracts.
#
# CORETSIA_BOOT_* values are resolved by the Kernel before ConfigKernel Phase B.
# They may select appEnv, project-wide activeTargets, global/target presets,
# module overrides, debug and the artifact cache directory.
#
# Phase B package configuration keys use uppercase dot-path projection:
# foundation.ids.default -> FOUNDATION_IDS_DEFAULT.
# Supported automatic Phase B overlays are limited to ruleset-declared
# scalar keys: boolean true|false|1|0, canonical decimal integers, and strings.
# Phase B overlays override PHP package configuration after bootstrap.
# They MUST NOT reselect the frozen Phase A appEnv, preset or application set.
#
# Kernel Bootstrap Phase A (canonical CORETSIA_BOOT_* allowlist)
#
# Uncomment only the values needed for this application.
# CORETSIA_BOOT_APP_ENV=local                                           # Non-empty safe appEnv string.
# CORETSIA_BOOT_ACTIVE_TARGETS=["web","worker"]                         # Non-empty JSON list; api|console|web|worker.
# CORETSIA_BOOT_PRESET=micro                                            # Global preset fallback.
# CORETSIA_BOOT_PRESETS={"worker":"hybrid"}                             # JSON object: AppTarget -> preset.
# CORETSIA_BOOT_MODULE_OVERRIDES_INCLUDE={"worker":["platform.worker"]} # JSON object: AppTarget -> ModuleId list.
# CORETSIA_BOOT_MODULE_OVERRIDES_EXCLUDE={"web":[]}                     # JSON object; [] explicitly clears the named list.
# CORETSIA_BOOT_DEBUG=false                                             # Exactly true|false|1|0.
# CORETSIA_BOOT_ARTIFACTS_CACHE_DIR=var/cache                           # Safe application-relative directory.
#
# These are the only supported CORETSIA_BOOT_* keys. Unsupported aliases and
# invalid scalar/JSON values fail closed in permitted source layers.
# activeTargets is project-wide installation membership, not runtime target selection.
# If absent, DependencySync uses ['web']; an explicit [] is invalid.
# An empty JSON map {} is a no-op for presets and module override maps.
# A target-specific preset overrides the merged global preset fallback.
#
# Initial appEnv selection:
# explicit BootstrapInput -> explicit AllowSystem process CORETSIA_BOOT_APP_ENV
# -> .env.local -> .env -> config/app.php -> kernel.boot.default_env.
# Process environment selects appEnv only with explicitly requested AllowSystem.
# After appEnv selection, the value is frozen before loading .env.<appEnv>
# and .env.<appEnv>.local; their CORETSIA_BOOT_APP_ENV must match the frozen value.
#
# Default policy: strict_dotenv for local/staging/other non-production appEnv;
# allow_system for prod/production. strict_dotenv ignores process values;
# allow_system gives permitted process values precedence over dotenv values.
# The production default does not reopen initial appEnv selection.
#
# Bootstrap source precedence: permitted process env, .env.<appEnv>.local,
# .env.<appEnv>, .env.local, .env, config/app.php, Kernel defaults.
# activeTargets replaces the complete lower-priority list. presets and
# module override maps merge independently per target and include/exclude field.
# A higher-priority {"web":[]} explicitly clears only that field.

# Foundation
# FOUNDATION_CONTAINER_AUTOWIRE_CONCRETE=true                 # true|false|1|0
# FOUNDATION_CONTAINER_ALLOW_REFLECTION_FOR_CONCRETE=true     # true|false|1|0
# FOUNDATION_IDS_DEFAULT=uuid                                 # ulid|uuid
# FOUNDATION_RESET_TAG=kernel.reset                           # non-empty, no whitespace
# FOUNDATION_RESET_PRIORITY_ENABLED=true                      # true|false|1|0

# Kernel (Phase B config; KERNEL_BOOT_* does not alter current Phase A bootstrap)
# KERNEL_BOOT_DEFAULT_ENV=local                               # non-empty string
# KERNEL_BOOT_DEFAULT_PRESET=micro                            # non-empty preset name
# KERNEL_BOOT_DEFAULT_DEBUG=false                             # true|false|1|0
# KERNEL_RUNTIME_HTTP_DRIVER=http.classic                     # http.classic|http.frankenphp|http.swoole|http.roadrunner
# KERNEL_ENV_SOURCE_POLICY_DEFAULT_LOCAL=strict_dotenv        # fixed: strict_dotenv
# KERNEL_ENV_SOURCE_POLICY_DEFAULT_PRODUCTION=allow_system    # fixed: allow_system
# KERNEL_MODULES_DISCOVERY_SOURCE=composer                    # supported: composer
# KERNEL_MODES_SCHEMA_VERSION=1                               # fixed: 1
# KERNEL_UOW_ATTRIBUTES_MAX_DEPTH=10                          # integer >= 1
# KERNEL_UOW_ATTRIBUTES_MAX_KEYS=200                          # integer >= 1

# CLI
# CLI_OUTPUT_FORMAT_DEFAULT=adaptive                          # adaptive|json|table|plain
# CLI_OUTPUT_ADAPTIVE_INTERACTIVE=table                       # json|table|plain
# CLI_OUTPUT_ADAPTIVE_NON_INTERACTIVE=table                   # json|table|plain
# CLI_OUTPUT_COLOR_DEFAULT=auto                               # auto|always|never
# CLI_OUTPUT_TABLE_MAX_WIDTH=120                              # integer 40..240

# Errors
# ERRORS_REPORTING_ENABLED=false                              # true|false|1|0
# ERRORS_REPORTING_MIN_SEVERITY=info                          # info|warning|error|critical
# ERRORS_REPORTING_SAMPLE_RATE=10000                          # integer 0..10000
# ERRORS_REPORTING_MAPPER_FAILURES_ENABLED=false              # true|false|1|0

# Logging
# LOGGING_DRIVER=stream                                       # stream|file|null (literal string null)
# LOGGING_FILE_PATH=/var/log/coretsia                         # administrator-controlled absolute directory; needed for file
# LOGGING_LEVEL=info                                          # debug|info|notice|warning|error|critical|alert|emergency
# LOGGING_MAX_RECORD_BYTES=65536                              # integer 1024..65536
# LOGGING_FORMAT=jsonl                                        # jsonl|logfmt

# Worker (only when platform.worker is installed and selected)
# WORKER_WORKERS=4                                            # integer >= 1
# WORKER_MAX_REQUESTS=1000                                    # integer >= 1
# WORKER_TASK_TYPE=queue                                      # queue|http
# WORKER_DRIVER=auto                                          # auto|pcntl|proc
# WORKER_CONTROL_TRANSPORT=auto                               # auto|unix|tcp
# WORKER_TCP_HOST=127.0.0.1                                   # fixed: 127.0.0.1
# WORKER_TCP_PORT=9327                                        # integer 1..65535
# WORKER_START_TIMEOUT_MS=10000                               # integer 1..86400000
# WORKER_STOP_TIMEOUT_MS=10000                                # integer 1..86400000
# WORKER_FORCE_KILL_TIMEOUT_MS=1000                           # integer 1..86400000

# ConfigKernel Phase B does not automatically expose lists, maps,
# relative-safe-path, or reset-group-id fields through environment overlays.
# Configure them in config/roots.php or config/<root>.php unless an explicitly
# supported mapping exists. This does not restrict Phase A CORETSIA_BOOT_*
# JSON-list/JSON-map inputs defined above.
