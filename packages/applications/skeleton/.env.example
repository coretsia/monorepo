# Environment template
#
# Copy this file to .env and uncomment only the overrides you need.
# No environment variables are required by every Coretsia application.
# Keep .env out of version control; never commit real secrets here.
#
# Package configuration keys use uppercase dot-path projection:
# foundation.ids.default -> FOUNDATION_IDS_DEFAULT.
# Supported automatic overlays are limited to ruleset-declared scalar keys.
# Values: boolean true|false|1|0; integers as decimal digits; strings as text.
# Environment overlays override PHP package configuration after bootstrap.
# These variables do not select appEnv, preset, targets, or moduleOverrides
# for the current bootstrap; use config/app.php for those settings.

# Foundation
# FOUNDATION_CONTAINER_AUTOWIRE_CONCRETE=true                 # true|false|1|0
# FOUNDATION_CONTAINER_ALLOW_REFLECTION_FOR_CONCRETE=true     # true|false|1|0
# FOUNDATION_IDS_DEFAULT=uuid                                 # ulid|uuid
# FOUNDATION_RESET_TAG=kernel.reset                           # non-empty, no whitespace
# FOUNDATION_RESET_PRIORITY_ENABLED=true                      # true|false|1|0

# Kernel (Phase B config; KERNEL_BOOT_* does not alter current Phase A bootstrap)
# KERNEL_BOOT_DEFAULT_ENV=local                               # non-empty string
# KERNEL_BOOT_DEFAULT_PRESET=micro                            # non-empty preset name
# KERNEL_BOOT_DEFAULT_DEBUG=false                             # true|false|1|0
# KERNEL_RUNTIME_HTTP_DRIVER=http.classic                     # http.classic|http.frankenphp|http.swoole|http.roadrunner
# KERNEL_ENV_SOURCE_POLICY_DEFAULT_LOCAL=strict_dotenv        # fixed: strict_dotenv
# KERNEL_ENV_SOURCE_POLICY_DEFAULT_PRODUCTION=allow_system    # fixed: allow_system
# KERNEL_MODULES_DISCOVERY_SOURCE=composer                    # supported: composer
# KERNEL_MODES_SCHEMA_VERSION=1                               # fixed: 1
# KERNEL_UOW_ATTRIBUTES_MAX_DEPTH=10                          # integer >= 1
# KERNEL_UOW_ATTRIBUTES_MAX_KEYS=200                          # integer >= 1

# CLI
# CLI_OUTPUT_FORMAT_DEFAULT=adaptive                          # adaptive|json|table|plain
# CLI_OUTPUT_ADAPTIVE_INTERACTIVE=table                       # json|table|plain
# CLI_OUTPUT_ADAPTIVE_NON_INTERACTIVE=table                   # json|table|plain
# CLI_OUTPUT_COLOR_DEFAULT=auto                               # auto|always|never
# CLI_OUTPUT_TABLE_MAX_WIDTH=120                              # integer 40..240

# Errors
# ERRORS_REPORTING_ENABLED=false                              # true|false|1|0
# ERRORS_REPORTING_MIN_SEVERITY=info                          # info|warning|error|critical
# ERRORS_REPORTING_SAMPLE_RATE=10000                          # integer 0..10000
# ERRORS_REPORTING_MAPPER_FAILURES_ENABLED=false              # true|false|1|0

# Logging
# LOGGING_DRIVER=stream                                       # stream|file|null (literal string null)
# LOGGING_FILE_PATH=/var/log/coretsia                         # administrator-controlled absolute directory; needed for file
# LOGGING_LEVEL=info                                          # debug|info|notice|warning|error|critical|alert|emergency
# LOGGING_MAX_RECORD_BYTES=65536                              # integer 1024..65536
# LOGGING_FORMAT=jsonl                                        # jsonl|logfmt

# Worker (only when platform.worker is installed and selected)
# WORKER_WORKERS=4                                            # integer >= 1
# WORKER_MAX_REQUESTS=1000                                    # integer >= 1
# WORKER_TASK_TYPE=queue                                      # queue|http
# WORKER_DRIVER=auto                                          # auto|pcntl|proc
# WORKER_CONTROL_TRANSPORT=auto                               # auto|unix|tcp
# WORKER_TCP_HOST=127.0.0.1                                   # fixed: 127.0.0.1
# WORKER_TCP_PORT=9327                                        # integer 1..65535
# WORKER_START_TIMEOUT_MS=10000                               # integer 1..86400000
# WORKER_STOP_TIMEOUT_MS=10000                                # integer 1..86400000
# WORKER_FORCE_KILL_TIMEOUT_MS=1000                           # integer 1..86400000

# Lists, maps, relative-safe-path, and reset-group-id keys are not automatically
# exposed as environment overlays. Configure them in config/roots.php or
# config/<root>.php. Custom roots need explicit supported env mappings.
