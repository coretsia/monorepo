// Explicit dependency synchronization runs before normal CLI host boot.
$dependencySyncOperation = $argv[1] ?? null;

if (\in_array($dependencySyncOperation, ['plan', 'review', 'apply'], true)) {
    $entrypoint = __DIR__ . '/bin/dependency-sync.php';

    if (!\is_file($entrypoint) || \is_link($entrypoint) || !\is_readable($entrypoint)) {
        @\fwrite(\STDERR, "CORETSIA_CLI_BOOTSTRAP_FAILED: autoload-unavailable\n");
        exit(1);
    }

    try {
        @require $entrypoint;
    } catch (\Throwable) {
        exit(1);
    }

    exit(1);
}

// All other commands delegate to the Composer-installed CLI.
$binary = __DIR__ . '/vendor/bin/coretsia';

if (!\is_file($binary) || !\is_readable($binary)) {
    @\fwrite(\STDERR, "CORETSIA_CLI_BOOTSTRAP_FAILED: autoload-unavailable\n");
    exit(1);
}

try {
    $exitCode = require __DIR__ . '/vendor/bin/coretsia';
} catch (\Throwable) {
    exit(1);
}

exit(\is_int($exitCode) && $exitCode >= 0 && $exitCode <= 255 ? $exitCode : 1);
