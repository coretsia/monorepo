// Delegation to the Composer-installed CLI is the only execution path.
$binary = __DIR__ . '/vendor/bin/coretsia';

if (!\is_file($binary) || !\is_readable($binary)) {
    @\fwrite(\STDERR, "CORETSIA_CLI_BOOTSTRAP_FAILED: autoload-unavailable\n");
    exit(1);
}

try {
    $exitCode = require __DIR__ . '/vendor/bin/coretsia';
} catch (\Throwable) {
    exit(1);
}

exit(\is_int($exitCode) && $exitCode >= 0 && $exitCode <= 255 ? $exitCode : 1);
