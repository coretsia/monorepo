{
  "name": "coretsia/platform-cli",
  "type": "library",
  "description": "Coretsia CLI runtime package: tag-first command discovery, Kernel operations, and deterministic safe output.",
  "keywords": [
    "coretsia",
    "php",
    "framework",
    "cli",
    "runtime",
    "commands",
    "command-discovery",
    "kernel-operations",
    "deterministic",
    "redaction"
  ],
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Vladyslav Mudrichenko",
      "email": "vladyslav@coretsia.dev",
      "role": "Creator and Lead Developer"
    }
  ],
  "homepage": "https://coretsia.dev/",
  "support": {
    "issues": "https://github.com/coretsia/monorepo/issues",
    "source": "https://github.com/coretsia/monorepo"
  },
  "bin": [
    "bin/coretsia"
  ],
  "require": {
    "php": "^8.4",
    "coretsia/core-contracts": "^0.10.0",
    "coretsia/core-foundation": "^0.10.0",
    "coretsia/core-kernel": "^0.10.0",
    "coretsia/platform-errors": "^0.10.0",
    "coretsia/platform-redaction": "^0.10.0",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Coretsia\\Platform\\Cli\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Coretsia\\Platform\\Cli\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "extra": {
    "coretsia": {
      "kind": "runtime",
      "moduleId": "platform.cli",
      "moduleClass": "Coretsia\\Platform\\Cli\\Module\\CliModule",
      "providers": [
        "Coretsia\\Platform\\Cli\\Provider\\CliServiceProvider"
      ],
      "requires": [
        "core.kernel",
        "platform.errors",
        "platform.redaction"
      ],
      "conflicts": [],
      "defaultsConfigPath": "config/cli.php"
    }
  }
}
